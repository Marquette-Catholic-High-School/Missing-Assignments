# Copy this file to .env and fill it in. Lines starting with # are ignored.

# Public address of the app, no trailing slash. Used for the Google redirect.
BASE_URL=https://slips.example.org

# Google sign-in. Create these in Google Cloud Console (see README).
# Leave both blank to run without sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only Google accounts on this domain may sign in. Strongly recommended.
ALLOWED_DOMAIN=mymchs.org

# Random string used to sign session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=

# Optional settings
#PORT=3000
#SUBMIT_TO=Mrs. Maag
#SESSION_HOURS=12
